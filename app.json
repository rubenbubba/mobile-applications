{
  "expo": {
    "name": "Vitrine",
    "slug": "vitrine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vitrine",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rubenbubba.vitrine"
    },
    "android": {
      "package": "com.rubenbubba.vitrine",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [["expo-router", { "sitemap": false }]],
    "experiments": {
      "typedRoutes": true
    }
  }
}
